{
  "name": "whyanchor-monorepo",
  "private": true,
  "type": "module",
  "description": "whyanchor workspace root. The published CLI lives in apps/cli (package name: whyanchor).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w whyanchor --"
  }
}
