# Names only. Real values go in the Vercel / Render dashboards, or in a gitignored .env.local.
# Never commit values. Which service needs which variable: docs/sprint-0-plan.md, section 3.

# --- all services ---
APP_URL=                              # public URL of the web app, e.g. https://whyanchor.vercel.app
SENTRY_DSN=

# --- apps/web (Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # the key formerly called "anon"
DATABASE_URL_POOLED=                  # Supabase transaction pooler (port 6543), role app_rls
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=             # web only; the private key below is NEVER on Vercel
NEXT_PUBLIC_GITHUB_APP_SLUG=whyanchor-dev
NEXT_PUBLIC_SENTRY_DSN=

# --- apps/api and apps/worker (Render) ---
DATABASE_URL=                         # Supabase SESSION pooler (port 5432); direct is IPv6-only
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_B64=           # base64 of the .pem, avoids multiline env var problems
GITHUB_WEBHOOK_SECRET=                # api only

# --- apps/worker only ---
WORK_DIR=/tmp/whyanchor
ANTHROPIC_API_KEY=                    # Sprint 6, not needed yet
