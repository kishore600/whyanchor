{
  "name": "@whyanchor/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "whyanchor cloud background worker: clones repos, computes staleness, runs PR checks. Deploys to Render as a Docker background worker.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
